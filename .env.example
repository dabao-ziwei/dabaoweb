# The Node server reads process environment. Load this explicitly in your host.
CMS_HOST=127.0.0.1
CMS_PORT=4280
CMS_ORIGIN=http://localhost:4280
CMS_PUBLIC_ORIGINS=http://localhost:4280
# Keep this OUTSIDE the website repository, on a persistent volume.
# CMS_DATA_DIR=/absolute/private/path/DabaoCMS
# Production requires NODE_ENV=production and an HTTPS CMS_ORIGIN.
# Do not store administrator passwords in this file.
